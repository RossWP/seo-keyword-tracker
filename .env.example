# Copy to .env to override. Every value has a working local default, so .env is optional.

# Postgres container (compose.yaml). The API builds its connection URL from these values
# (localhost + POSTGRES_PORT); set DATABASE_URL instead to point it at another database.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
# Host port; 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433
